<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiBankingExercise.Views.TransactionView"
             xmlns:views="clr-namespace:MauiBankingExercise.Views"
             xmlns:viewmodels="clr-namespace:MauiBankingExercise.ViewModels"
             xmlns:models="clr-namespace:MauiBankingExercise.Models"
             Title="{Binding SelectedAccount.AccountNumber, StringFormat='Account: {0}'}" 
             x:DataType="viewmodels:TransactionViewModel">

    <views:BasePage.Resources>
        <Style TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                        Value="LightSkyBlue" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </views:BasePage.Resources>

    
    <VerticalStackLayout Padding="10" Spacing="15">

        <CollectionView ItemsSource="{Binding Transactions}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <Border 
                               Padding="15"
                               Margin="0,5"
                               BackgroundColor="#D1ECF1">
                        <Grid ColumnDefinitions="Auto, *"
                                  RowDefinitions="Auto, Auto, Auto">

                            <!-- Amount -->
                            <Label Text="{Binding Amount, StringFormat='R{0:F2}'}"
                                       Grid.Column="0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"
                                       VerticalOptions="Start" />

                            <!-- Description -->
                            <Label Text="{Binding Description}"
                                       Grid.Column="1"
                                       FontSize="16"
                                       TextColor="Black"
                                       VerticalOptions="Start" />

                            <!-- Date -->
                            <Label Text="{Binding TransactionDate, StringFormat='{0:MMM dd, yyyy hh:mm tt}'}"
                                       Grid.ColumnSpan="2"
                                       Grid.Row="1"
                                       FontSize="14"
                                       TextColor="Gray"
                                       Margin="0,5,0,0" />

                            <!-- Transaction Id (optional) -->
                            <Label Text="{Binding TransactionId}"
                                       Grid.ColumnSpan="2"
                                       Grid.Row="2"
                                       FontSize="12"
                                       TextColor="DarkGray" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Button below list -->
        <Button Text="Add Transaction"
                Command="{Binding AddTransactionCommand}"
                BackgroundColor="LightSkyBlue"
                TextColor="White"
                CornerRadius="10"
                HorizontalOptions="Center" />

    </VerticalStackLayout>
</views:BasePage>
